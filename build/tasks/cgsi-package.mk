ifeq ($(USES_DEVICE_CGSI),true)

ifneq ($(CGSI_CUSTOM_BUILD_ID),)
CGSI_CUSTOM_BUILD_ID := -$(CGSI_CUSTOM_BUILD_ID)
endif

CGSI_PACKAGE_FILENAME := CGSI-$(CGSI_CUSTOM_ROM_NAME)-$(CGSI_CUSTOM_ROM_BRANCH)-$(BUILD_ID)-$(LOCAL_BUILD_DATE)$(CGSI_CUSTOM_BUILD_ID)-$(PRODUCT_DEVICE)

INSTALLED_CGSI_PACKAGE_TARGET := $(PRODUCT_OUT)/$(CGSI_PACKAGE_FILENAME).zip
INSTALLED_CGSI_PACKAGE_TARGET_DEPS := $(PRODUCT_OUT)/system.img

LOCAL_SOONG_ZIP_EXEC := $(HOST_OUT_EXECUTABLES)/soong_zip

$(INSTALLED_CGSI_PACKAGE_TARGET): $(INSTALLED_CGSI_PACKAGE_TARGET_DEPS) $(LOCAL_SOONG_ZIP_EXEC)
	$(LOCAL_SOONG_ZIP_EXEC) -o $@ -C $(PRODUCT_OUT) $(foreach f,$(INSTALLED_CGSI_PACKAGE_TARGET_DEPS), -f $(f))

.PHONY: cgsi-package
cgsi-package: $(INSTALLED_CGSI_PACKAGE_TARGET)

endif # USES_DEVICE_CGSI
